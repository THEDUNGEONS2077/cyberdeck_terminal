{
  "manifest_version": 3,
  "name": "CYBERDECK BRIDGE",
  "version": "1.2.0",
  "description": "Connects cyberdeck_terminal to your bookmarks bar (read-only), shows their site icons, and opens it on every new tab.",
  "key": "",
  "permissions": [
    "bookmarks",
    "favicon"
  ],
  "host_permissions": [
    "https://thedungeons2077.github.io/cyberdeck_terminal/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://thedungeons2077.github.io/cyberdeck_terminal/*",
      "http://127.0.0.1/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "https://thedungeons2077.github.io/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
